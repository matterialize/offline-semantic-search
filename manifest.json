{
  "manifest_version": 3,
  "name": "Offline Semantic Search",
  "version": "1.0.0",
  "description": "Free, open-source search for relevant text on the current page. Private, offline, with no account or subscription.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Search this page by meaning"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Open Offline Semantic Search"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'; worker-src 'self'; frame-ancestors 'self' http: https: file:"
  }
}
